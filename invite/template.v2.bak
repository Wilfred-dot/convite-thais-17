  <clipPath id="sheetClip" clipPathUnits="objectBoundingBox"><path d="M0.03 0.30 C0.10 0.10 0.22 0.03 0.36 0.10 S0.58 0.03 0.72 0.09 S0.93 0.03 0.98 0.27 C1.01 0.46 0.94 0.62 0.98 0.78 C0.93 0.97 0.78 0.92 0.66 0.97 S0.42 1 0.30 0.94 S0.08 0.98 0.03 0.80 C-0.01 0.62 0.06 0.46 0.03 0.30Z">
    <animate attributeName="d" dur="10s" repeatCount="indefinite" calcMode="spline" keyTimes="0;.5;1" keySplines=".45 0 .55 1;.45 0 .55 1" values="M0.03 0.30 C0.10 0.10 0.22 0.03 0.36 0.10 S0.58 0.03 0.72 0.09 S0.93 0.03 0.98 0.27 C1.01 0.46 0.94 0.62 0.98 0.78 C0.93 0.97 0.78 0.92 0.66 0.97 S0.42 1 0.30 0.94 S0.08 0.98 0.03 0.80 C-0.01 0.62 0.06 0.46 0.03 0.30Z;M0.02 0.34 C0.08 0.04 0.24 0.08 0.34 0.04 S0.60 0.10 0.74 0.03 S0.95 0.12 0.99 0.30 C1.03 0.42 0.92 0.66 0.99 0.74 C0.95 1 0.76 0.95 0.64 1 S0.40 0.94 0.28 1 S0.05 0.94 0.02 0.84 C-0.03 0.64 0.08 0.44 0.02 0.34Z;M0.03 0.30 C0.10 0.10 0.22 0.03 0.36 0.10 S0.58 0.03 0.72 0.09 S0.93 0.03 0.98 0.27 C1.01 0.46 0.94 0.62 0.98 0.78 C0.93 0.97 0.78 0.92 0.66 0.97 S0.42 1 0.30 0.94 S0.08 0.98 0.03 0.80 C-0.01 0.62 0.06 0.46 0.03 0.30Z"/>
  </path></clipPath>
