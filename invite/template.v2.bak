<title>Thais 17 Anos</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;1,6..96,400&family=Jost:wght@300;400;500&family=Pinyon+Script&display=swap">
<style>
/* Concept: céu nocturno vinho feito de seda a fluir, com estrelas a cintilar; ouro champanhe; coluna única centrada, letras grandes. */
:root{--wine-950:#14020a;--wine-900:#22040e;--silk:#f3e6dc;--champagne:#d8b98a;--rose:#e9b9bd;
--display:'Bodoni Moda',Georgia,serif;--body:Jost,system-ui,sans-serif;--script:'Pinyon Script','Snell Roundhand',cursive;color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--wine-950);color:var(--silk);font-family:var(--body);font-weight:300;overflow-x:hidden}
body.locked{overflow:hidden}
:focus-visible{outline:2px solid var(--champagne);outline-offset:3px;border-radius:4px}
h1,h2,h3,p,ul{margin:0}
button{font:inherit;color:inherit}
#app{position:relative}
#bg{position:fixed;inset:0;width:100%;height:100%;z-index:0;display:block}

/* ---------- Abertura ---------- */
.curtain{position:fixed;inset:0;z-index:60;overflow:hidden}
.curtain.done{pointer-events:none}
.panel{position:absolute;top:0;bottom:0;width:50.5%;transition:transform 5s cubic-bezier(.55,0,.25,1);background:repeating-linear-gradient(97deg,rgba(0,0,0,0) 0 26px,rgba(255,196,208,.07) 38px,rgba(0,0,0,.22) 64px),linear-gradient(100deg,#1d040c 0%,#5a1028 38%,#3b0a1a 62%,#1a040c 100%)}
.panel.l{left:0;border-right:1px solid rgba(216,185,138,.55)}
.panel.r{right:0;border-left:1px solid rgba(216,185,138,.55);transform:scaleX(-1)}
.curtain.open .panel.l{transform:translateX(-102%)}
.curtain.open .panel.r{transform:scaleX(-1) translateX(-102%)}
.light{position:absolute;inset:0;z-index:5;pointer-events:none;opacity:0;transition:opacity 3.4s ease-in-out;background:radial-gradient(ellipse 80% 65% at 50% 52%,#fff 0%,rgba(255,246,236,.96) 28%,rgba(255,226,216,.72) 55%,rgba(255,214,205,.25) 80%,rgba(255,214,205,0) 100%)}
.curtain.lit .light{opacity:1}
.curtain.fade .light{opacity:0;transition-duration:3.6s}
.seal{position:absolute;inset:0 0 25% 0;z-index:2;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:0 16px;transition:opacity 1.8s ease,transform 3s ease}
.curtain.open .seal{opacity:0;transform:scale(1.06)}
.cv-fest{font:400 clamp(2.6rem,12.5vw,6rem)/1.05 var(--script);color:var(--champagne)}
.cv-da{display:flex;align-items:center;gap:1rem;margin:.2rem 0;font:italic 400 clamp(1.3rem,5vw,2rem) var(--display);color:var(--silk);opacity:.85}
.cv-da::before,.cv-da::after{content:"";width:3rem;height:1px;background:linear-gradient(90deg,transparent,var(--champagne))}
.cv-da::after{transform:scaleX(-1)}
.cv-name{font:500 clamp(4.6rem,27vw,11rem)/.9 var(--display);letter-spacing:-.01em}
.cv-age{margin-top:1rem;font:400 clamp(1rem,4vw,1.5rem) var(--display);letter-spacing:.45em;padding-left:.45em;color:var(--silk)}
.cv-to{margin-top:1.6rem;font-size:.72rem;letter-spacing:.3em;text-transform:uppercase;opacity:.7}
.cv-guest{margin-top:.3rem;font:italic 400 clamp(1.5rem,6.5vw,2.2rem)/1.25 var(--display);color:var(--rose);max-width:20ch}
.ribbon{position:absolute;inset:0;width:100%;height:100%;z-index:3;pointer-events:none;overflow:visible}
.ribbon path{fill:none;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:0;transition:stroke-dashoffset 2.6s cubic-bezier(.65,0,.3,1) .5s,opacity 2.4s ease .9s}
.curtain.untie .ribbon path{stroke-dashoffset:1;opacity:.1}
.knot{position:absolute;left:50%;top:76%;z-index:4;transform:translate(-50%,-50%)}
.bow{position:absolute;left:50%;top:50%;width:min(94vw,400px);transform:translate(-50%,-47%);overflow:visible;z-index:-1}
.bow g{transform-box:view-box;transform-origin:180px 108px;transition:transform 2s cubic-bezier(.5,0,.3,1),opacity 1.8s ease}
.curtain.untie .bow .a{transform:scale(.05) rotate(-70deg);opacity:0}
.curtain.untie .bow .b{transform:scale(.05) rotate(70deg);opacity:0;transition-delay:.15s}
.curtain.untie .bow .c{transform:scale(.05) rotate(-90deg);opacity:0;transition-delay:.3s}
.curtain.untie .bow .d{transform:scale(.05) rotate(90deg);opacity:0;transition-delay:.45s}
.curtain.untie .bow .t1{transform:translate(-30px,260px) rotate(-26deg);opacity:0;transition-duration:2.2s}
.curtain.untie .bow .t2{transform:translate(30px,260px) rotate(26deg);opacity:0;transition-duration:2.2s;transition-delay:.2s}
.open-btn{position:relative;display:grid;place-items:center;min-width:9.6rem;height:3.4rem;padding:0 1.8rem;border-radius:999px;cursor:pointer;border:0;font:500 1rem var(--body);letter-spacing:.06em;color:#2a0714;background:linear-gradient(180deg,#f6e3bf,#c9a46c);box-shadow:0 0 0 5px rgba(216,185,138,.28),0 10px 30px rgba(0,0,0,.55);transition:opacity 1.1s ease .2s,transform 1.4s ease .2s}
.open-btn:hover{filter:brightness(1.06)}
.curtain.untie .open-btn{opacity:0;transform:scale(.6) rotate(10deg);pointer-events:none}

/* ---------- Componentes ---------- */
.gold{background:linear-gradient(180deg,#f6e3bf 0%,#d8b98a 45%,#a9824b 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
.outline{color:transparent;-webkit-text-stroke:1px rgba(216,185,138,.85)}
.glass{background:linear-gradient(160deg,rgba(255,255,255,.07),rgba(255,255,255,.02));border:1px solid rgba(216,185,138,.28);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 1.6rem;border-radius:999px;font:400 1.02rem var(--body);letter-spacing:.04em;transition:transform .25s,background .25s;cursor:pointer;text-align:center;text-decoration:none;color:var(--silk);border:1px solid rgba(216,185,138,.7);background:transparent}
.btn:hover{background:rgba(216,185,138,.14)}
.btn.g{background:linear-gradient(180deg,#f1d9a8,#c9a46c);color:#2a0714;font-weight:500;border-color:transparent}
.btn.g:hover{transform:translateY(-2px);background:linear-gradient(180deg,#f6e3bf,#d1ad73)}
.btn[aria-disabled="true"]{opacity:.5;cursor:default;pointer-events:none}
.lab{display:flex;align-items:center;justify-content:center;gap:.9rem;font:500 .7rem var(--body);letter-spacing:.34em;text-transform:uppercase;color:var(--champagne);padding-left:.34em}
.lab::before,.lab::after{content:"";height:1px;width:2.2rem;background:linear-gradient(90deg,transparent,rgba(216,185,138,.7))}
.lab::after{transform:scaleX(-1)}
.mini{font:500 .64rem var(--body);letter-spacing:.3em;text-transform:uppercase;color:var(--champagne);opacity:.9}
main{position:relative;z-index:10;max-width:36rem;margin:0 auto;text-align:center;padding-inline:max(22px,env(safe-area-inset-left,0px))}
h2{margin-top:1.1rem;font:400 clamp(2.1rem,7.4vw,2.7rem)/1.15 var(--display);text-wrap:balance}
section{padding-block:4.5rem}
.disp{font-family:var(--display)}.it{font-style:italic}.muted{opacity:.75}
.stack{display:flex;flex-direction:column;gap:.75rem;margin-top:1.75rem}
.copy{max-width:36ch;margin:1.25rem auto 0;line-height:1.7;opacity:.88;font-size:1.05rem}
a.lnk{color:var(--champagne);text-underline-offset:4px;text-decoration-color:rgba(216,185,138,.4)}
.tiny{font-size:.82rem;opacity:.65;letter-spacing:.04em;line-height:1.6}
.sep{height:1px;margin:3.25rem auto;max-width:15rem;background:linear-gradient(90deg,transparent,rgba(216,185,138,.7),transparent)}
.rv{opacity:0;will-change:opacity,transform}
.hl{color:var(--champagne);font-weight:500}

/* ---------- Herói ---------- */
.hero{min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding-block:4rem 3rem}
.hero-el{opacity:0;transform:translateY(18px);filter:blur(8px);transition:opacity 2s ease,transform 2.2s cubic-bezier(.2,.7,.2,1),filter 2s ease}
.opened .hero-el{opacity:1;transform:none;filter:none}
.big17{font:500 clamp(12rem,62vw,20rem)/.78 var(--display);user-select:none}
.name{position:absolute;left:0;right:0;bottom:-.3rem;white-space:nowrap;font:500 min(14.2vw,5.4rem)/.95 var(--display);color:var(--silk);text-shadow:0 4px 24px rgba(20,2,10,.8);margin:0}
.hr12{display:flex;align-items:baseline;justify-content:center;gap:.6rem;margin-top:.35rem}
.hr12 span{font:italic 400 1.35rem var(--display);opacity:.85}
.hr12 b{font:italic 500 clamp(3.4rem,15vw,4.6rem)/1 var(--display)}

/* ---------- Contagem ---------- */
.cd{display:grid;grid-template-columns:repeat(4,1fr);gap:.5rem;margin-top:2rem}
.cd>div{border-radius:1rem;padding:1.1rem 0}
.cd b{display:block;font:400 clamp(2rem,9vw,2.7rem) var(--display);font-variant-numeric:tabular-nums}
.cd span{font-size:.74rem;letter-spacing:.06em;opacity:.7}
.cdmsg{margin-top:1.5rem;font:italic 400 clamp(1.5rem,6vw,2rem)/1.3 var(--display);color:var(--rose);min-height:1px}

/* ---------- Eixo vertical (programa e local) ---------- */
.axis{position:relative;margin-top:2.5rem;display:flex;flex-direction:column;align-items:center}
.axis::before{content:"";position:absolute;left:50%;top:0;bottom:0;width:1px;background:rgba(216,185,138,.18)}
.axis::after{content:"";position:absolute;left:50%;top:0;width:1px;height:var(--fill,0%);background:linear-gradient(180deg,rgba(216,185,138,.2),rgba(216,185,138,.95));box-shadow:0 0 10px rgba(216,185,138,.6);transition:height .3s linear}
.pt{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;padding:0 1.2rem;margin-bottom:2.4rem;background:radial-gradient(closest-side,rgba(26,4,12,.78),rgba(26,4,12,0))}
.pt:last-child{margin-bottom:0}
.dot{width:11px;height:11px;border-radius:50%;background:#4a3a2a;box-shadow:0 0 0 4px rgba(216,185,138,.06);transition:background .8s ease,box-shadow .8s ease,transform .8s ease;margin-bottom:.7rem}
.pt.on .dot{background:#f1d9a8;box-shadow:0 0 0 4px rgba(216,185,138,.22),0 0 18px 4px rgba(241,217,168,.8);transform:scale(1.15)}
.pt time{font:400 1.8rem var(--display);color:var(--champagne);opacity:.45;transition:opacity .8s}
.pt .t{font:400 1.4rem var(--display);opacity:.55;transition:opacity .8s}
.pt .s{opacity:.4;transition:opacity .8s}
.pt.on time,.pt.on .t{opacity:1}.pt.on .s{opacity:.78}
.pl .v{font:400 clamp(1.7rem,7vw,2.1rem)/1.2 var(--display);opacity:.5;transition:opacity .9s,text-shadow .9s}
.pl.on .v{opacity:1}
.pl .mini{opacity:.45;transition:opacity .9s}.pl.on .mini{opacity:1}
.pl.casa{position:relative}
.pl.casa .v{font-style:italic;font-size:clamp(2.1rem,9vw,2.7rem);color:var(--rose)}
.pl.casa::before{content:"";position:absolute;left:50%;top:60%;width:22rem;height:14rem;max-width:130vw;transform:translate(-50%,-50%) scale(.4);opacity:0;pointer-events:none;z-index:-1;background:radial-gradient(closest-side,rgba(255,250,240,.9),rgba(255,214,200,.45) 38%,rgba(255,200,190,0) 100%);transition:opacity 1.6s ease,transform 2s ease}
.pl.casa.lit::before{opacity:1;transform:translate(-50%,-50%) scale(1);animation:glow 3.4s ease-in-out infinite alternate}
.pl.casa.lit .v{color:#fff;text-shadow:0 0 18px rgba(255,236,220,.95),0 0 42px rgba(255,200,190,.7)}
@keyframes glow{from{filter:brightness(.8);transform:translate(-50%,-50%) scale(.92)}to{filter:brightness(1.25);transform:translate(-50%,-50%) scale(1.08)}}
.hora{display:flex;flex-direction:column;align-items:center;gap:.4rem;margin-top:1.5rem}
.hora b{font:italic 500 clamp(3.6rem,17vw,5rem)/1 var(--display)}
.hora p.v{font:400 1.5rem var(--display)}
.hora .punct{font:italic 400 1.25rem var(--display);color:var(--champagne)}

/* ---------- Dress code ---------- */
.sw-row{display:flex;gap:1.5rem;justify-content:center;align-items:flex-start;margin-top:2.25rem}
.swb{display:flex;flex-direction:column;align-items:center;gap:.8rem;background:none;border:0;cursor:pointer;padding:.4rem}
.sw{position:relative;display:block;width:min(36vw,8.5rem);height:min(36vw,8.5rem);border-radius:50%;overflow:hidden;box-shadow:0 0 0 1px rgba(216,185,138,.55),0 14px 40px rgba(0,0,0,.5);transition:box-shadow .5s ease,transform .5s ease}
.swb[aria-pressed="true"] .sw{box-shadow:0 0 0 2px var(--champagne),0 0 0 8px rgba(216,185,138,.18),0 0 34px rgba(216,185,138,.35),0 14px 40px rgba(0,0,0,.5);transform:scale(1.04)}
.swb .lb{font:italic 400 1.3rem var(--display);opacity:.7;transition:opacity .4s,color .4s}
.swb[aria-pressed="true"] .lb{opacity:1;color:var(--champagne)}
.sw i,.fab i{position:absolute;display:block;width:230%;height:62%;left:-65%;border-radius:50%;filter:blur(8px);animation:sw1 6s ease-in-out infinite alternate;animation-play-state:paused}
.live .sw i,.live .fab i{animation-play-state:running}
.sw i:nth-child(1),.fab i:nth-child(1){top:6%;transform:rotate(-18deg)}
.sw i:nth-child(2),.fab i:nth-child(2){top:44%;transform:rotate(-12deg);animation-name:sw2;animation-duration:7.5s}
.sw i:nth-child(3),.fab i:nth-child(3){top:72%;transform:rotate(-20deg);animation-duration:5.2s}
@keyframes sw1{from{transform:translate3d(-8%,-6%,0) rotate(-18deg)}to{transform:translate3d(10%,10%,0) rotate(-10deg)}}
@keyframes sw2{from{transform:translate3d(9%,6%,0) rotate(-12deg)}to{transform:translate3d(-10%,-8%,0) rotate(-19deg)}}
.k,.fab.k{background:#000}
.k i:nth-child(1){background:linear-gradient(90deg,transparent,rgba(120,120,135,.22),transparent)}
.k i:nth-child(2){background:linear-gradient(90deg,transparent,rgba(60,60,70,.35),transparent)}
.k i:nth-child(3){background:linear-gradient(90deg,transparent,rgba(90,90,105,.16),transparent)}
.w,.fab.w{background:linear-gradient(135deg,#fbf6ef,#efe5d9 55%,#f9f3ea)}
.w i:nth-child(1){background:linear-gradient(90deg,transparent,rgba(255,255,255,.95),transparent)}
.w i:nth-child(2){background:linear-gradient(90deg,transparent,rgba(190,160,150,.5),transparent)}
.w i:nth-child(3){background:linear-gradient(90deg,transparent,rgba(214,190,180,.5),transparent)}
.fab.v{background:linear-gradient(135deg,#3a0a1a,#7b1634 50%,#4a0d20)}
.fab.v i:nth-child(1){background:linear-gradient(90deg,transparent,rgba(255,190,205,.45),transparent)}
.fab.v i:nth-child(2){background:linear-gradient(90deg,transparent,rgba(30,2,10,.7),transparent)}
.fab.v i:nth-child(3){background:linear-gradient(90deg,transparent,rgba(233,120,150,.35),transparent)}
.sheetwrap{margin:1.75rem -.5rem 0;filter:drop-shadow(0 18px 26px rgba(0,0,0,.55))}
.combo{position:relative;height:min(78vw,17rem);overflow:hidden;clip-path:url(#sheetClip)}
.fab{position:absolute;overflow:hidden}
.fab.base{inset:0}
.fab.v{top:0;bottom:0;left:-12%;width:124%;clip-path:url(#waveClip);animation:sway 7s ease-in-out infinite alternate;animation-play-state:paused}
.live .fab.v{animation-play-state:running}
@keyframes sway{from{transform:translateX(-4%)}to{transform:translateX(4%)}}
.cap{margin-top:1.1rem;font:italic 400 1.5rem var(--display);color:var(--rose)}

/* ---------- Presente ---------- */
.gift{margin:1.75rem auto 0;max-width:22ch;font:italic 400 clamp(1.7rem,6.8vw,2.2rem)/1.4 var(--display);color:#f0dcd6;opacity:.92}
.dig{margin-top:2.5rem}
.dig-t{background:none;border:0;cursor:pointer;font:400 1.05rem var(--body);letter-spacing:.16em;color:var(--champagne);text-decoration:underline;text-underline-offset:7px;text-decoration-color:rgba(216,185,138,.4);padding:.5rem .75rem}
.dig-t:hover{text-decoration-color:var(--champagne)}
.dig-h{display:block;margin-top:.35rem;font-size:.78rem;letter-spacing:.08em;opacity:.6}
.dig-h::after{content:" ▾";display:inline-block;transition:transform .4s}
.dig.open .dig-h::after{transform:rotate(180deg)}
.dig-p{display:grid;grid-template-rows:0fr;transition:grid-template-rows .6s ease}
.dig-p>div{overflow:hidden;min-height:0}
.dig.open .dig-p{grid-template-rows:1fr}
.dig-in{padding-top:.9rem;font-size:.88rem;line-height:1.8;opacity:.85}
.dig-in b{font:400 1.1rem var(--display);letter-spacing:.06em;color:var(--champagne)}
.cp{background:none;border:1px solid rgba(216,185,138,.45);color:var(--silk);border-radius:999px;font:400 .74rem var(--body);letter-spacing:.14em;padding:.4rem 1rem;margin-top:.6rem;cursor:pointer}
.cp:hover{border-color:var(--champagne)}

/* ---------- Confirmação ---------- */
.dlc{margin-top:.9rem;font-size:.95rem;opacity:.85;letter-spacing:.03em}
.dlc em{font:italic 500 1.35rem var(--display);color:#f1d9a8;font-style:italic}
.fine{margin-top:1.1rem;font:italic 400 1rem var(--display);opacity:.7}

/* ---------- Álbum ---------- */
.steps{list-style:none;padding:0;margin:2rem 0 0;display:flex;flex-direction:column;gap:.9rem;text-align:left}
.steps li{display:flex;gap:1rem;align-items:flex-start;padding:1rem 1.1rem;border-radius:1.2rem}
.steps .n{flex:none;width:1.9rem;height:1.9rem;border-radius:50%;display:grid;place-items:center;font:400 .95rem var(--display);color:var(--champagne);border:1px solid rgba(216,185,138,.6)}
.steps p{line-height:1.55}
.steps li.key{padding:1.3rem 1.2rem;border-color:rgba(216,185,138,.75);background:linear-gradient(160deg,rgba(216,185,138,.16),rgba(255,255,255,.03))}
.steps li.key p{font:italic 400 1.3rem/1.45 var(--display)}
.steps li.key .n{background:var(--champagne);color:#2a0714;border-color:var(--champagne)}
.social{display:flex;flex-direction:column;align-items:center;text-align:center;border-radius:1.4rem;padding:1.4rem 1.2rem;margin-top:1.1rem;text-decoration:none;color:inherit;gap:.35rem}
.social svg{flex:none}
.social b{font:400 1.45rem var(--display);color:var(--champagne)}
.social .tiny{max-width:30ch;opacity:.8}
.social .btn{min-height:42px;padding:0 1.3rem;margin-top:.7rem}

/* ---------- Despedida e rodapé ---------- */
.bye{margin-inline:-1rem;padding-block:4rem 3.5rem}
.bye-1{font:italic 400 clamp(2.3rem,10.5vw,3.5rem)/1.25 var(--display);text-wrap:balance}
.bye-3{margin:1.75rem auto 0;max-width:30ch;font-size:1.08rem;line-height:1.8;opacity:.85}
.bye-2{margin-top:2rem;font:italic 500 clamp(1.9rem,8vw,2.7rem)/1.3 var(--display);color:#f1d9a8}
.sig{margin-top:1.5rem;font:400 clamp(2.4rem,11vw,3.4rem)/1.2 var(--script);color:var(--champagne)}
.bye-d{margin-top:2.4rem;font-size:.82rem;letter-spacing:.32em;text-transform:uppercase;opacity:.65;padding-left:.32em}
footer{padding-block:1.3rem 1.4rem;font-size:.72rem;letter-spacing:.05em;border-top:1px solid rgba(216,185,138,.15);line-height:1.9;color:rgba(243,230,220,.6)}
footer a{color:var(--champagne);text-underline-offset:3px;text-decoration-color:rgba(216,185,138,.35)}
.car{display:inline-block;font:italic 500 1.25rem var(--display);letter-spacing:.06em;text-decoration:none;background:linear-gradient(100deg,#7d838e 0%,#7d838e 38%,#ffffff 50%,#7d838e 62%,#7d838e 100%);background-size:260% 100%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;animation:car 3.2s linear infinite,pulse 1.8s ease-in-out infinite alternate}
@keyframes car{from{background-position:130% 0}to{background-position:-30% 0}}
@keyframes pulse{from{filter:drop-shadow(0 0 1px rgba(220,226,236,.2))}to{filter:drop-shadow(0 0 7px rgba(230,235,245,.75))}}
.fl{display:flex;gap:1.25rem;justify-content:center;margin:.1rem 0}

/* ---------- Panos ---------- */
.drape{-webkit-mask-image:linear-gradient(transparent,#000 28%,#000 72%,transparent);mask-image:linear-gradient(transparent,#000 28%,#000 72%,transparent);height:96px;margin:-48px calc(50% - 50vw);overflow:hidden;pointer-events:none;position:relative;z-index:1}
.drape svg{position:absolute;left:0;top:0;width:240%;height:100%;will-change:transform}
.vfab{position:absolute;top:0;bottom:0;right:-14px;width:72px;z-index:2;pointer-events:none;opacity:.8;
 background:linear-gradient(90deg,rgba(60,6,24,.0),rgba(150,26,60,.75) 25%,rgba(255,190,205,.5) 48%,rgba(120,16,48,.8) 70%,rgba(60,6,24,0));
 -webkit-mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='72' height='520' viewBox='0 0 72 520'><path d='M24 0 C10 70 44 120 26 190 S10 330 30 390 S40 470 24 520 L50 520 C64 460 30 410 52 340 S66 200 46 130 S56 50 48 0Z' fill='white'/></svg>") 0 0/72px 520px repeat-y;
 mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='72' height='520' viewBox='0 0 72 520'><path d='M24 0 C10 70 44 120 26 190 S10 330 30 390 S40 470 24 520 L50 520 C64 460 30 410 52 340 S66 200 46 130 S56 50 48 0Z' fill='white'/></svg>") 0 0/72px 520px repeat-y;
 animation:flow 14s linear infinite}
@keyframes flow{from{-webkit-mask-position:0 0;mask-position:0 0;background-position:0 0}to{-webkit-mask-position:0 520px;mask-position:0 520px;background-position:0 520px}}
#mus{position:fixed;z-index:40;right:max(16px,env(safe-area-inset-right,0px));bottom:max(16px,env(safe-area-inset-bottom,0px));width:48px;height:48px;border-radius:50%;display:none;place-items:center;color:var(--champagne);cursor:pointer}
.opened #mus{display:grid}
@media (prefers-reduced-motion:reduce){.panel,.seal,.hero-el,.bow g,.ribbon path,.light,.dig-p,.dot{transition-duration:.01s!important;transition-delay:0s!important}.sw i,.fab i,.fab.v,.vfab,.car,.pl.casa.lit::before{animation:none}.rv{opacity:1!important;transform:none!important}}
</style>

<div id="app">
<canvas id="bg" aria-hidden="true"></canvas>
<audio id="aud" loop preload="none" src="__MUSIC__"></audio>
