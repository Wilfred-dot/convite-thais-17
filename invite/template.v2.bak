  <linearGradient id="rbd" x1="0" x2="1"><stop offset="0" stop-color="#3a0714"/><stop offset=".5" stop-color="#5e1128"/><stop offset="1" stop-color="#3a0714"/></linearGradient>
  <linearGradient id="rbm" x1="0" x2="1"><stop offset="0" stop-color="#6e1630"/><stop offset=".5" stop-color="#93243f"/><stop offset="1" stop-color="#6e1630"/></linearGradient>
  <linearGradient id="bw" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8e2243"/><stop offset=".55" stop-color="#5a0f26"/><stop offset="1" stop-color="#3a0714"/></linearGradient>
  <radialGradient id="bh" cx=".35" cy=".3" r=".7"><stop offset="0" stop-color="#ff9db5" stop-opacity=".55"/><stop offset="1" stop-color="#ff9db5" stop-opacity="0"/></radialGradient>
</defs></svg>

<div class="curtain" id="cur" role="dialog" aria-label="Convite">
  <div class="panel l"></div><div class="panel r"></div>
  <div class="seal">
    <p class="cv-fest">Festa de Aniversário</p>
    <p class="cv-da">da</p>
    <h1 class="cv-name gold">Thais<br>Laysa</h1>
    <p class="cv-age">17 Anos</p>
    <p class="cv-to">Convite para</p>
    <p class="cv-guest" id="g1">Convidado(a)</p>
  </div>
  <svg class="ribbon" id="rib" aria-hidden="true">
    <path pathLength="1" stroke="url(#rbd)" stroke-width="68"/><path pathLength="1" stroke="url(#rbd)" stroke-width="68"/>
    <path pathLength="1" stroke="url(#rbm)" stroke-width="46"/><path pathLength="1" stroke="url(#rbm)" stroke-width="46"/>
    <path pathLength="1" stroke="#ff9db5" stroke-opacity=".28" stroke-width="9"/><path pathLength="1" stroke="#ff9db5" stroke-opacity=".28" stroke-width="9"/>
  </svg>
  <div class="knot">
    <svg class="bow" viewBox="0 0 360 230" aria-hidden="true">
      <g class="t1"><path d="M168 118 L112 222 L140 208 L156 228 L190 122Z" fill="url(#bw)"/><path d="M168 118 L112 222 L124 214 L170 130Z" fill="#000" fill-opacity=".18"/></g>
      <g class="t2"><path d="M192 118 L248 222 L220 208 L204 228 L170 122Z" fill="url(#bw)"/><path d="M192 118 L248 222 L236 214 L190 130Z" fill="#000" fill-opacity=".18"/></g>
      <g class="c"><path d="M180 112 C120 150 40 190 22 156 C10 126 84 98 180 112Z" fill="url(#bw)"/><path d="M180 112 C120 150 40 190 22 156 C10 126 84 98 180 112Z" fill="url(#bh)"/></g>
      <g class="d"><path d="M180 112 C240 150 320 190 338 156 C350 126 276 98 180 112Z" fill="url(#bw)"/><path d="M180 112 C240 150 320 190 338 156 C350 126 276 98 180 112Z" fill="url(#bh)"/></g>
      <g class="a"><path d="M180 106 C150 30 70 2 36 44 C14 80 80 128 180 106Z" fill="url(#bw)"/><path d="M180 106 C150 30 70 2 36 44 C14 80 80 128 180 106Z" fill="url(#bh)"/><path d="M60 44 C90 30 130 50 160 90" fill="none" stroke="#ff9db5" stroke-opacity=".35" stroke-width="3" stroke-linecap="round"/></g>
      <g class="b"><path d="M180 106 C210 30 290 2 324 44 C346 80 280 128 180 106Z" fill="url(#bw)"/><path d="M180 106 C210 30 290 2 324 44 C346 80 280 128 180 106Z" fill="url(#bh)"/><path d="M300 44 C270 30 230 50 200 90" fill="none" stroke="#ff9db5" stroke-opacity=".35" stroke-width="3" stroke-linecap="round"/></g>
    </svg>
    <button class="open-btn" id="openBtn" autofocus>Abrir convite</button>
  </div>
  <div class="light"></div>
</div>

<button id="mus" class="glass" aria-label="Pausar música" title="Música"><svg id="ico" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><rect x="5" y="4" width="5" height="16" rx="1"/><rect x="14" y="4" width="5" height="16" rx="1"/></svg></button>

<div class="vfab" aria-hidden="true"></div>

<main id="main">
  <header class="hero">
    <p class="hero-el cv-fest" style="transition-delay:.2s">Festa de Aniversário</p>
    <p class="hero-el cv-da" style="transition-delay:.5s">da</p>
    <div style="position:relative;width:100%;margin-top:.5rem">
      <div class="hero-el big17 outline" aria-hidden="true" style="transition-delay:.9s">17</div>
      <h2 class="hero-el name" style="transition-delay:1.3s">Thais Laysa</h2>
    </div>
    <p class="hero-el" style="margin-top:1.5rem;letter-spacing:.42em;padding-left:.42em;opacity:.9;font-size:1.05rem;transition-delay:1.7s">Pereira Fone Wah</p>
    <p class="hero-el disp it" style="margin-top:.6rem;font-size:1.45rem;color:var(--champagne);transition-delay:1.9s">celebra os seus 17 anos</p>
    <div class="hero-el" style="margin-top:1.5rem;transition-delay:2.2s">
      <p class="mini">Convite para</p>
      <p class="disp it" id="g2" style="margin-top:.4rem;font-size:clamp(1.8rem,8vw,2.4rem);color:var(--rose);line-height:1.25">Convidado(a)</p>
    </div>
    <div class="hero-el" style="margin-top:2.5rem;transition-delay:2.5s">
      <p class="mini">Data e hora</p>
      <p class="disp it gold" style="margin-top:.5rem;font-size:clamp(4.2rem,21vw,6rem);line-height:1">Sábado</p>
      <p style="margin-top:.6rem;font-size:1.4rem">31 de Outubro de 2026</p>
      <p class="hr12"><span>às</span><b class="gold">12</b><span>horas</span></p>
    </div>
  </header>

  <section>
    <p class="lab">Dedicatória</p>
    <blockquote class="disp it" style="margin:2rem 0 0;font-size:clamp(1.45rem,5.8vw,1.8rem);line-height:1.6">“Aos 17 anos, celebro o que já vivi e tudo o que ainda vou escrever. Quero ter-te ao meu lado num almoço cheio de elegância e boa energia. A tua presença faz este dia ainda mais especial.”</blockquote>
    <p class="sig" style="font-size:2.6rem;margin-top:1.25rem">Thais Laysa</p>
  </section>

  <section style="padding-block:2.5rem 3rem">
    <p class="lab">Contagem decrescente</p>
    <h2>Faltam</h2>
    <div class="cd" id="cd" role="timer"></div>
    <p class="cdmsg" id="cdmsg"></p>
  </section>

  <section>
    <p class="lab">Programa</p>
    <h2>O dia, hora a hora</h2>
    <div class="axis" id="axP">
      <div class="pt"><span class="dot"></span><time>12h00</time><p class="t">Chegada</p><p class="s">Recepção dos convidados</p></div>
      <div class="pt"><span class="dot"></span><time>12h30</time><p class="t">Sessão de fotos</p><p class="s">Os primeiros retratos do dia</p></div>
      <div class="pt"><span class="dot"></span><time>13h30</time><p class="t">Almoço</p><p class="s">Todos à mesa</p></div>
      <div class="pt"><span class="dot"></span><time>15h00</time><p class="t">Bolo e parabéns</p><p class="s">O momento de apagar as velas</p></div>
      <div class="pt"><span class="dot"></span><time>16h00</time><p class="t">Música e dança</p><p class="s">Até quando a energia durar</p></div>
    </div>
  </section>

  <section>
    <p class="lab">Local</p>
    <div class="axis" id="axL">
      <div class="pt pl"><span class="dot"></span><p class="mini">Bairro</p><p class="v">Bairro do Aeroporto</p></div>
      <div class="pt pl"><span class="dot"></span><p class="mini">Entrada</p><p class="v">Entrada do Machute</p></div>
      <div class="pt pl casa" id="casa"><span class="dot"></span><p class="mini">Casa</p><p class="v">Casa da Celia</p></div>
    </div>
    <div class="rvb" style="margin-top:2.5rem">
      <p class="mini">Localização</p>
      <p class="copy" style="margin-top:.75rem">Abre o mapa para ver o caminho até à casa. Se preferires, podes pedir um Yango directamente até ao local.</p>
      <div class="stack"><a class="btn g" href="https://maps.app.goo.gl/EKpGaaGp4C91dchL6" target="_blank" rel="noopener">Ver no mapa</a></div>
    </div>

    <div class="sep"></div>
    <p class="lab">Hora</p>
    <div class="hora">
      <b class="gold">12h00</b>
      <p class="v">A chegada é às 12h00</p>
      <p class="punct">Pedimos pontualidade.</p>
    </div>

    <div class="sep"></div>
    <p class="lab">Calendário</p>
    <p class="copy" style="margin-top:1rem">Guarda a data no teu calendário para não te esqueceres.</p>
    <div class="stack"><a class="btn g" id="cal" href="#" target="_blank" rel="noopener">Adicionar ao calendário</a></div>
    <p class="tiny" style="margin-top:.8rem">Abre o calendário do teu telemóvel. <a class="lnk" id="calAlt" href="__ICS__" download="thais-17-anos.ics">Outro calendário</a></p>
    <div class="sep" style="margin-bottom:0"></div>
  </section>

  <section id="dress">
    <p class="lab">Dress code</p>
    <h2>Preto ou branco</h2>
    <div class="sw-row">
      <button class="swb" id="bk" aria-pressed="true" aria-label="Preto"><span class="sw k"><i></i><i></i><i></i></span><span class="lb">Preto</span></button>
      <button class="swb" id="bw" aria-pressed="false" aria-label="Branco"><span class="sw w"><i></i><i></i><i></i></span><span class="lb">Branco</span></button>
    </div>
    <p class="copy" style="margin-top:.5rem">Escolhe uma só cor para todo o look. Toca numa cor para ver como fica com o vinho da festa.</p>
    <div class="sheetwrap"><div class="combo" id="combo" aria-live="polite">
      <div class="fab base k" id="cbase"><i></i><i></i><i></i></div>
      <div class="fab v"><i></i><i></i><i></i></div>
    </div></div>
    <p class="cap" id="ccap">Preto com vinho</p>
    <p class="tiny" style="margin-top:.5rem">Acessórios em tons de vinho são muito bem-vindos.</p>
  </section>

  <section>
    <p class="lab">Presente</p>
    <p class="gift">Os presentes são bem-vindos e serão recebidos com muito carinho.</p>
    <div class="dig" id="dig">
      <button class="dig-t" id="digT" aria-expanded="false" aria-controls="digP">Prefere presente digital?<span class="dig-h">Clica aqui para ver como enviar</span></button>
      <div class="dig-p" id="digP"><div><div class="dig-in">
        e-Mola para <b>86 756 6153</b><br>Titular: Francisco Madoro<br>
        <button class="cp" data-copy="867566153">Copiar número</button>
      </div></div></div>
    </div>
  </section>

  <section>
    <p class="lab">Confirmação</p>
    <h2>Responde até 28 de Outubro</h2>
    <p class="dlc" id="dlc"></p>
    <div class="stack">
      <a class="btn g" id="yes" href="#" target="_blank" rel="noopener">Confirmo presença</a>
      <a class="btn" id="no" href="#" target="_blank" rel="noopener">Não poderei ir</a>
    </div>
    <p class="fine">Resposta rápida por WhatsApp.</p>
    <div style="margin-top:3.5rem">
      <p class="lab">Contactos</p>
      <p class="copy" style="margin-top:1rem">Dúvidas? Liga para um destes números.</p>
      <p class="tiny" style="margin-top:.6rem">Se precisares de direcções para chegar à casa, é só ligar.</p>
      <div class="stack">
        <a class="btn" href="tel:+258860466777">86 046 6777</a>
        <a class="btn" href="tel:+258875112320">87 511 2320</a>
      </div>
      <p class="tiny" style="margin-top:1rem">Clica para ligar.</p>
    </div>
  </section>

  <section>
    <p class="lab">Memórias</p>
    <h2>Álbum de memórias</h2>
    <p class="copy">Todas as fotos e vídeos da festa, num só álbum no Google.</p>
    <ul class="steps">
      <li class="glass"><span class="n">1</span><p>Tira as tuas fotos e vídeos durante a festa.</p></li>
      <li class="glass key"><span class="n">2</span><p>No dia da festa, o álbum abre e fica disponível durante 3 dias. Junta lá tudo o que tiraste.</p></li>
      <li class="glass"><span class="n">3</span><p>A tua pasta já leva o teu nome, para sabermos de quem são.</p></li>
    </ul>
    <div class="stack"><a class="btn g" id="album" href="#" target="_blank" rel="noopener">Abrir o meu álbum</a></div>
    <p class="tiny" id="albumNote" style="margin-top:.75rem">O botão abre no dia da festa.</p>

    <div class="social glass" style="margin-top:2.25rem">
      <p class="mini">Hashtag da festa</p>
      <p class="disp" style="font-size:1.9rem;color:var(--silk)">#ThaisWah17</p>
      <p class="tiny" style="max-width:32ch;opacity:.8">Uma hashtag junta todas as publicações sobre o mesmo tema. Escreve #ThaisWah17 na legenda das tuas fotos no Instagram, para ficarem todas juntas.</p>
      <button class="btn" data-copy="#ThaisWah17">Copiar hashtag</button>
    </div>
    <a class="social glass" href="https://www.instagram.com/thais_layysa" target="_blank" rel="noopener">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#d8b98a" stroke-width="1.4" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r=".9" fill="#d8b98a" stroke="none"/></svg>
      <b>@thais_layysa</b>
      <span class="tiny">O Instagram da Thais. Marca-a nas tuas fotos e acompanha o dia nos stories.</span>
    </a>
  </section>

  <section class="bye">
    <p class="lab">Até lá</p>
    <p class="bye-1" style="margin-top:1.75rem">A tua presença tornará este dia ainda mais especial.</p>
    <p class="bye-3">Cada pessoa que me acompanha faz parte desta história. Que este dia seja leve, bonito e cheio de memórias para guardar para sempre.</p>
    <p class="bye-2">Com carinho, espero por ti.</p>
    <p class="sig">Thais Laysa Pereira Fone Wah</p>
    <p class="bye-d">Outubro de 2026</p>
  </section>

  <footer>
    Convite digital por <a class="car" id="cred" href="#" target="_blank" rel="noopener">Wilfred Deloviar</a><br>
    Queres um convite assim?
    <div class="fl"><a id="cred2" href="#" target="_blank" rel="noopener">WhatsApp</a><a href="__VCF__" download="wilfred-deloviar.vcf">Guardar contacto</a></div>
    Clica aqui para falar comigo ou guardar o meu contacto.
  </footer>
</main>
</div>

<script>
(function(){
  var G="__GUEST__",ALBUM_LIVE=__ALBUM_LIVE__;
  var START=Date.parse("2026-10-31T12:00:00+02:00"),DL=Date.parse("2026-10-28T23:59:59+02:00"),A_OPEN=Date.parse("2026-10-31T00:00:00+02:00"),A_CLOSE=Date.parse("2026-11-02T23:59:59+02:00");
  var $=function(id){return document.getElementById(id)};
  var wa=function(p,t){return "https://wa.me/"+p+"?text="+encodeURIComponent(t)};
  var reduce=window.matchMedia&&matchMedia("(prefers-reduced-motion: reduce)").matches;
  var vh=function(){return window.innerHeight};

  /* nome do convidado */
  var slug=(location.hash||"").slice(1),name="";
  if(G&&G.indexOf("__")!==0)name=G;
  else if(slug){var small={de:1,da:1,do:1,das:1,dos:1,e:1};name=slug.split("-").filter(Boolean).map(function(w,i){return i>0&&small[w]?w:w.charAt(0).toUpperCase()+w.slice(1)}).join(" ")}
  var has=!!name;if(!has)name="Convidado(a)";
  $("g1").textContent=name;$("g2").textContent=name;
  var who=has?"Sou "+name+" e ":"";
  $("yes").href=wa("258867566153","Olá! "+who+"confirmo a minha presença na festa dos 17 anos da Thais Laysa, no sábado, 31/10. Até lá!");
  $("no").href=wa("258867566153","Olá! "+who+"infelizmente não poderei comparecer na festa dos 17 anos da Thais Laysa, no sábado, 31/10. Um grande abraço e muitas felicidades!");
  var msg="Olá Wilfred! Vi o convite da Thais e gostava de um convite digital como este.";
  $("cred").href=wa("258868991785",msg);$("cred2").href=wa("258868991785",msg);

  /* calendário: um só botão que escolhe o melhor destino */
  var gcal="https://calendar.google.com/calendar/render?action=TEMPLATE&text="+encodeURIComponent("17 anos da Thais Laysa")+"&dates=20261031T100000Z/20261031T160000Z&location="+encodeURIComponent("Casa da Celia, Entrada do Machute, Bairro do Aeroporto, Beira")+"&details="+encodeURIComponent("Dress code: preto ou branco. Confirma a presença até 28 de Outubro.");
  var ios=/iPad|iPhone|iPod/.test(navigator.userAgent)||(navigator.platform==="MacIntel"&&navigator.maxTouchPoints>1);
  var cal=$("cal");
  if(ios){cal.href=$("calAlt").getAttribute("href");cal.setAttribute("download","thais-17-anos.ics");cal.removeAttribute("target")}else{cal.href=gcal}

  /* álbum partilhado (abre 31/10, durante 3 dias) */
  (function(){var a=$("album"),n=$("albumNote"),now=Date.now();
    function off(t){a.setAttribute("aria-disabled","true");a.removeAttribute("href");n.textContent=t}
    if(!ALBUM_LIVE)return off("O botão abre no dia da festa.");
    var s=(name&&has)?name.toLowerCase().normalize("NFC").replace(/[^\p{L}\p{N}\s-]/gu,"").trim().replace(/\s+/g,"-"):"convidado";
    a.href="/album/"+encodeURIComponent(s);
    if(now<A_OPEN)off("O botão abre no dia 31 de Outubro.");
    else if(now>A_CLOSE)off("O álbum fechou. Obrigada por partilhares.");
    else n.textContent="Toca para abrir a tua pasta e juntar as tuas fotos e vídeos."})();

  /* prazo de resposta */
  (function(){var d=DL-Date.now(),el=$("dlc");
    if(d<0)el.textContent="O prazo terminou.";
    else{var n=Math.ceil(d/864e5);el.innerHTML=n<=1?"<em>Hoje</em> é o último dia para responder.":"Faltam <em>"+n+" dias</em> para responder."}})();

  /* abertura lenta: laço, cortinas, luz branca, convite */
  document.body.classList.add("locked");
  var aud=$("aud"),ico=$("ico");
  var PAUSE='<rect x="5" y="4" width="5" height="16" rx="1"/><rect x="14" y="4" width="5" height="16" rx="1"/>',PLAY='<path d="M7 4l13 8-13 8z"/>';
  function setIco(p){ico.innerHTML=p?PAUSE:PLAY;$("mus").setAttribute("aria-label",p?"Pausar música":"Tocar música")}
  $("openBtn").addEventListener("click",function(){
    var c=$("cur"),k=reduce?.02:1,T=function(f,ms){setTimeout(f,ms*k)};
    c.classList.add("untie");
    T(function(){c.classList.add("open")},2600);
    T(function(){c.classList.add("lit")},4600);
    T(function(){$("app").classList.add("opened");c.classList.add("fade");c.classList.add("done");document.body.classList.remove("locked");reveal();lights()},7900);
    T(function(){c.hidden=true},12000);
    try{aud.volume=0;var pr=aud.play();if(pr&&pr.then)pr.then(function(){setIco(true);var v=0,id=setInterval(function(){v=Math.min(.45,v+.02);aud.volume=v;if(v>=.45)clearInterval(id)},150)}).catch(function(){setIco(false)})}catch(e){setIco(false)}
  });
  $("mus").addEventListener("click",function(){try{if(aud.paused){aud.volume=.45;aud.play();setIco(true)}else{aud.pause();setIco(false)}}catch(e){}});

  /* contagem */
  function tick(){var d=START-Date.now(),el=$("cd"),m=$("cdmsg");
    var s=Math.max(0,Math.floor(d/1000)),u=[["dias",Math.floor(s/86400)],["horas",Math.floor(s%86400/3600)],["minutos",Math.floor(s%3600/60)],["segundos",s%60]];
    el.innerHTML=u.map(function(x){return '<div class="glass"><b class="gold">'+String(x[1]).padStart(2,"0")+'</b><span>'+x[0]+'</span></div>'}).join("");
    m.textContent=d<=0?"Parabéns, Thais Laysa! A festa já começou.":""}
  tick();setInterval(tick,1000);

  /* copiar */
  document.addEventListener("click",function(e){var b=e.target.closest("[data-copy]");if(!b)return;
    var t=b.getAttribute("data-copy"),old=b.textContent,ok=function(){b.textContent="Copiado";setTimeout(function(){b.textContent=old},2000)};
    var fb=function(){var a=document.createElement("textarea");a.value=t;document.body.appendChild(a);a.select();try{document.execCommand("copy")}catch(x){}a.remove();ok()};
    try{navigator.clipboard.writeText(t).then(ok,fb)}catch(x){fb()}});

  /* presente digital */
  $("digT").addEventListener("click",function(){var o=$("dig").classList.toggle("open");this.setAttribute("aria-expanded",o)});

  /* dress code: tocar na própria cor */
  function pick(k){$("cbase").className="fab base "+(k?"k":"w");$("bk").setAttribute("aria-pressed",k);$("bw").setAttribute("aria-pressed",!k);$("ccap").textContent=(k?"Preto":"Branco")+" com vinho"}
  $("bk").addEventListener("click",function(){pick(true)});$("bw").addEventListener("click",function(){pick(false)});
  new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)$("dress").classList.add("live")})},{threshold:.1}).observe($("dress"));

  /* panos entre secções */
  var drapes=[];
  [].slice.call(document.querySelectorAll("#main section")).forEach(function(s,i){if(i===0)return;
    var d=document.createElement("div");d.className="drape";d.setAttribute("aria-hidden","true");
    d.innerHTML='<svg viewBox="0 0 400 60" preserveAspectRatio="none" style="left:-70%"><path d="M0 30 C60 0 140 60 200 30 S340 0 400 30 V60 H0Z" fill="url(#dg)"/></svg>';
    s.parentNode.insertBefore(d,s);drapes.push(d)});

  /* aparecer aos poucos com o scroll */
  var rvs=[];
  [].slice.call(document.querySelectorAll("#main section > *:not(.drape), #main footer > *, .steps li")).forEach(function(el){if(el.closest(".hero"))return;el.classList.add("rv");rvs.push({el:el,p:0})});
  function reveal(){var h=vh();rvs.forEach(function(o){if(o.p>=1)return;var r=o.el.getBoundingClientRect(),p=Math.min(1,Math.max(0,(h*.96-r.top)/(h*.32)));if(p>o.p){o.p=p;o.el.style.opacity=p;o.el.style.transform=p>=1?"":"translateY("+((1-p)*22)+"px)"}})}

  /* pontos que acendem e eixos que enchem */
  var axes=[].slice.call(document.querySelectorAll(".axis"));
  function lights(){var h=vh(),line=h*.66;
    axes.forEach(function(ax){var r=ax.getBoundingClientRect(),f=Math.min(1,Math.max(0,(line-r.top)/r.height));ax.style.setProperty("--fill",(f*100)+"%");
      var pts=ax.querySelectorAll(".pt"),last=null;
      [].forEach.call(pts,function(p){var t=p.getBoundingClientRect().top+10;if(t<line){p.classList.add("on");last=p}else p.classList.remove("on")});
      var c=$("casa");if(ax.contains(c)){c.classList.toggle("lit",c.classList.contains("on")&&f>.92)}})}

  /* fundo: seda a fluir e céu estrelado */
  var cv=$("bg"),cx=cv.getContext("2d"),W=0,H=0,sy=window.scrollY||0,stars=[];
  var bands=[
    {y:.02,th:.30,a1:.06,a2:.025,f1:.0042,f2:.011,sp:.00020,c1:"rgba(150,34,66,.34)",hl:"rgba(255,170,190,.13)",c2:"rgba(70,8,28,.5)"},
    {y:.16,th:.26,a1:.05,a2:.03,f1:.0036,f2:.013,sp:-.00026,c1:"rgba(120,18,48,.62)",hl:"rgba(233,150,170,.12)",c2:"rgba(58,8,24,.55)"},
    {y:.30,th:.30,a1:.07,a2:.025,f1:.0048,f2:.010,sp:.00031,c1:"rgba(190,60,95,.28)",hl:"rgba(255,190,205,.14)",c2:"rgba(60,6,24,.55)"},
    {y:.46,th:.27,a1:.05,a2:.03,f1:.0040,f2:.012,sp:-.00022,c1:"rgba(120,18,48,.6)",hl:"rgba(240,140,165,.12)",c2:"rgba(52,6,22,.55)"},
    {y:.60,th:.30,a1:.06,a2:.028,f1:.0045,f2:.0105,sp:.00028,c1:"rgba(165,38,72,.32)",hl:"rgba(255,180,198,.13)",c2:"rgba(66,8,28,.5)"},
    {y:.76,th:.28,a1:.055,a2:.03,f1:.0038,f2:.0125,sp:-.00030,c1:"rgba(118,16,46,.6)",hl:"rgba(216,150,150,.10)",c2:"rgba(50,5,20,.55)"}
  ];
  function size(){var dpr=Math.min(window.devicePixelRatio||1,1.5);W=window.innerWidth;H=window.innerHeight;cv.width=W*dpr;cv.height=H*dpr;cx.setTransform(dpr,0,0,dpr,0,0);
    stars=[];var n=Math.round(W*H/3000);for(var i=0;i<n;i++)stars.push({x:Math.random()*W,y:Math.random()*H,r:Math.random()*1.5+.4,p:Math.random()*6.28,s:Math.random()*1.8+.6,big:Math.random()<.13,g:Math.random()<.3})}
  function wave(b,i,x,ph,off){return Math.sin(x*b.f1+ph+off)*b.a1*H+Math.sin(x*b.f2-ph*1.35+i+off)*b.a2*H}
  function rad(x,y,r,col){var g=cx.createRadialGradient(x,y,0,x,y,r);g.addColorStop(0,col);g.addColorStop(1,"rgba(0,0,0,0)");cx.fillStyle=g;cx.fillRect(0,0,W,H)}
  function draw(t){
    cx.fillStyle="#1a040c";cx.fillRect(0,0,W,H);
    rad(W*.15,0,H*.9,"#5c1128");rad(W,H*.35,H*.7,"#3a0919");rad(W*.3,H*1.05,H*.9,"#4a0e21");
    bands.forEach(function(b,i){
      var ph=t*b.sp+sy*.0016*(i%2?-1:1)+i*1.3,y0=H*b.y+Math.sin(sy*.0007+i)*H*.04,th=H*b.th;
      cx.beginPath();
      for(var x=-40;x<=W+40;x+=18){var y=y0+wave(b,i,x,ph,0);x===-40?cx.moveTo(x,y):cx.lineTo(x,y)}
      for(var x2=W+40;x2>=-40;x2-=18){cx.lineTo(x2,y0+th+wave(b,i,x2,ph,.9))}
      cx.closePath();
      var gr=cx.createLinearGradient(0,y0-b.a1*H,0,y0+th+b.a1*H);
      gr.addColorStop(0,"rgba(0,0,0,0)");gr.addColorStop(.28,b.c1);gr.addColorStop(.52,b.hl);gr.addColorStop(.74,b.c2);gr.addColorStop(1,"rgba(0,0,0,0)");
      cx.fillStyle=gr;cx.fill();
      cx.beginPath();for(var x3=-40;x3<=W+40;x3+=18){var yy=y0+th*.5+wave(b,i,x3,ph,.45);x3===-40?cx.moveTo(x3,yy):cx.lineTo(x3,yy)}
      cx.strokeStyle="rgba(255,200,215,.09)";cx.lineWidth=1.2;cx.stroke();
    });
    for(var k=0;k<stars.length;k++){var s=stars[k],q=.5+.5*Math.sin(t*.0022*s.s+s.p),tw=reduce?.85:.12+.88*q*q;
      var col=s.g?"236,205,150":"255,246,238";
      cx.fillStyle="rgba("+col+","+tw+")";cx.beginPath();cx.arc(s.x,s.y,s.r*(.8+.5*tw),0,6.283);cx.fill();
      if(s.big&&tw>.45){var L=5+tw*12;cx.strokeStyle="rgba("+col+","+tw*.75+")";cx.lineWidth=.9;cx.beginPath();cx.moveTo(s.x-L,s.y);cx.lineTo(s.x+L,s.y);cx.moveTo(s.x,s.y-L);cx.lineTo(s.x,s.y+L);cx.stroke();
        cx.fillStyle="rgba("+col+","+tw*.18+")";cx.beginPath();cx.arc(s.x,s.y,L*.55,0,6.283);cx.fill()}}
  }
  function slide(){var h=vh();drapes.forEach(function(d){var r=d.getBoundingClientRect();if(r.bottom<-100||r.top>h+100)return;var p=(r.top+48)/h;d.firstChild.style.transform="translateX("+((p-.5)*-34)+"%)"})}
  function ribbon(){var w=window.innerWidth,h=window.innerHeight,y=h*.76,c=w/2,r=$("rib"),p=r.querySelectorAll("path");r.setAttribute("viewBox","0 0 "+w+" "+h);
    function d(sg,o){var yy=y+o;return "M"+c+" "+yy+" C"+(c+sg*w*.08)+" "+(yy-34)+" "+(c+sg*w*.16)+" "+(yy+34)+" "+(c+sg*w*.26)+" "+yy+" S"+(c+sg*w*.42)+" "+(yy-26)+" "+(c+sg*(w*.5+60))+" "+(yy+16)}
    var off=[0,0,0,0,-10,-10],sgn=[-1,1,-1,1,-1,1];for(var i=0;i<6;i++)p[i].setAttribute("d",d(sgn[i],off[i]))}
  ribbon();window.addEventListener("resize",ribbon);
  size();window.addEventListener("resize",size);
  window.addEventListener("scroll",function(){sy=window.scrollY;slide();reveal();lights()},{passive:true});
  if(reduce){draw(0)}else{(function loop(t){if(!document.hidden)draw(t);requestAnimationFrame(loop)})(0)}
  slide();
})();
</script>
